{
  "name": "@clauderipple/app",
  "version": "0.12.36",
  "private": true,
  "description": "ClaudeRipple menu-bar app (macOS). Hosts the local GUI served by the router and shows chain health in the tray.",
  "license": "GPL-3.0-only",
  "author": "pbj",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/sync-private-acl.mjs --check && node scripts/sync-admin-transport.mjs --check && tsc -p tsconfig.json",
    "sync:private-acl": "node scripts/sync-private-acl.mjs",
    "sync:admin-transport": "node scripts/sync-admin-transport.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "test:native": "npm run build && node test-native/run.mjs",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mts",
    "dist": "npm run icons && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir -c.forceCodeSigning=false -c.mac.identity=null -c.mac.notarize=false -c.directories.output=release-dev",
    "release": "node scripts/release.mjs mac",
    "dist:win": "npm run icons && npm run build && electron-builder --win --dir -c.forceCodeSigning=false -c.win.signExecutable=false -c.directories.output=release-dev",
    "release:win": "node scripts/release.mjs win"
  },
  "devDependencies": {
    "electron": "45.3.3"
  },
  "build": {
    "appId": "com.clauderipple.app",
    "productName": "ClaudeRipple",
    "electronVersion": "45.3.3",
    "forceCodeSigning": true,
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "beforePack": "scripts/stage-runtime.mjs",
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": true,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-native/runtime/${os}/${arch}",
        "to": "clauderipple"
      },
      {
        "from": "release-native/runtime/${os}/${arch}/node_modules",
        "to": "clauderipple/node_modules"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "signExecutable": true,
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "signingHashAlgorithms": ["sha256"]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClaudeRipple",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  }
}
